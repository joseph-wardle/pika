#usda 1.0
(
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Y"
)

# The scheme is unauthored, so Catmull-Clark. Hydra hands over the normals
# of a subdivided mesh too.
def Xform "world"
{
    def Camera "camera" {}

    def Mesh "strip"
    {
        int[] faceVertexCounts = [4, 4]
        int[] faceVertexIndices = [0, 1, 4, 3, 1, 2, 5, 4]
        int[] holeIndices = [1]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (2, 0, 0), (0, 1, 0), (1, 1, 0), (2, 1, 0)]
        normal3f[] normals = [(0, 0, 1)] (
            interpolation = "constant"
        )
    }
}
