#usda 1.0
(
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Y"
)

# A lightLink collection reaches the store as a token per distinct collection, empty for one that
# lights everything, and each mesh as its collections' tokens, its categories. The key links the
# left triangle, the rim the right, the fill everything. shadowLink gets tokens too, and the
# fill's shadows come only from the left triangle. Collections of the same prims share a token,
# so the fill's shadowLink is the key's lightLink token. The spot links one of two native
# instances, the instancer holding a category set per instance. Frame 2 links the key to both
# triangles, the rim to everything, and the fill's shadows to the right triangle.
def Xform "world"
{
    def Camera "camera" {}

    def Mesh "left"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "right"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Xform "first" (
        instanceable = true
        references = </prototype>
    )
    {
    }

    def Xform "second" (
        instanceable = true
        references = </prototype>
    )
    {
        double3 xformOp:translate = (0, 2, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def SphereLight "key"
    {
        uniform bool collection:lightLink:includeRoot = 0
        rel collection:lightLink:includes = </world/left>
    }

    def RectLight "rim"
    {
        uniform bool collection:lightLink:includeRoot = 0
        rel collection:lightLink:includes = </world/right>
    }

    def DistantLight "fill"
    {
        uniform bool collection:shadowLink:includeRoot = 0
        rel collection:shadowLink:includes = </world/left>
    }

    def SphereLight "spot"
    {
        uniform bool collection:lightLink:includeRoot = 0
        rel collection:lightLink:includes = </world/first>
    }
}

class Xform "prototype"
{
    def Mesh "tri"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"
    }
}
