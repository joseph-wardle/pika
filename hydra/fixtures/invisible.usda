#usda 1.0
(
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Y"
)

# A mesh under an invisible parent is invisible too.
def Xform "world"
{
    def Camera "camera" {}

    def Xform "group"
    {
        token visibility = "invisible"

        def Mesh "tri"
        {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"
        }
    }
}
