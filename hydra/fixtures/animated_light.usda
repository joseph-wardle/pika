#usda 1.0
(
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Y"
)

# A light's time-sampled inputs and transform are read again at each
# frame's time.
def Xform "world"
{
    def Camera "camera" {}

    def DistantLight "sun"
    {
        float inputs:intensity.timeSamples = {
            1: 10,
            2: 20,
        }
        float inputs:angle.timeSamples = {
            1: 0.53,
            2: 2,
        }
        float3 xformOp:rotateXYZ.timeSamples = {
            1: (0, 0, 0),
            2: (0, 90, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }
}
