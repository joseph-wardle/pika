#usda 1.0
(
    defaultPrim = "world"
    metersPerUnit = 1
    upAxis = "Y"
)

# A point instancer hands its positions, orientations and scales over as
# separate primvars, with the instancer's own transform beside them.
def Xform "world"
{
    def Camera "camera" {}

    def PointInstancer "scatter"
    {
        double3 xformOp:translate = (0, 0, 7)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        int[] protoIndices = [0, 0]
        point3f[] positions = [(1, 0, 0), (2, 0, 0)]
        # (real, i, j, k): no turn, and a third of a turn about (1, 1, 1).
        quath[] orientations = [(1, 0, 0, 0), (0.5, 0.5, 0.5, 0.5)]
        float3[] scales = [(1, 1, 1), (2, 2, 2)]
        rel prototypes = </world/scatter/prototypes/tri>

        def Scope "prototypes"
        {
            def Mesh "tri"
            {
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
                uniform token subdivisionScheme = "none"
            }
        }
    }
}
