    }

    def Material "white"
    {
        token outputs:surface.connect = <surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.7, 0.7, 0.7)
            float inputs:roughness = 1.0
            float inputs:metallic = 0.0
            token outputs:surface
        }
    }

    def Material "red"
    {
        token outputs:surface.connect = <surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.7, 0.08, 0.08)
            float inputs:roughness = 1.0
            float inputs:metallic = 0.0
            token outputs:surface
        }
    }

    def Material "green"
    {
        token outputs:surface.connect = <surface.outputs:surface>

        def Shader "surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.08, 0.55, 0.08)
            float inputs:roughness = 1.0
            float inputs:metallic = 0.0
            token outputs:surface
        }
    }

    def Mesh "floor" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-6, -1, 0), (6, -1, 0), (6, -1, -14), (-6, -1, -14)]
        rel material:binding = <../white>
    }

    def Mesh "block" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = </world/_cube>
    )
    {
        rel material:binding = <../white>
        double3 xformOp:translate = (-0.8, -0.5, -5.6)
        float xformOp:rotateY = 20
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
    }

    def Mesh "tall" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = </world/_cube>
    )
    {
        rel material:binding = <../white>
        double3 xformOp:translate = (0.75, -0.25, -5.9)
        float xformOp:rotateY = -15
        float3 xformOp:scale = (0.9, 1.5, 0.9)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
    }

    def Mesh "ball" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = </world/_ball>
    )
    {
        rel material:binding = <../white>
        double3 xformOp:translate = (0.2, -0.6, -4.6)
        float xformOp:rotateY = 0
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
    }

    def Mesh "near" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = </world/_cube>
    )
    {
        rel material:binding = <../white>
        double3 xformOp:translate = (-1.9, -0.5, -4.4)
        float xformOp:rotateY = 0
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
    }

    def Mesh "beside" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        references = </world/_cube>
    )
    {
        rel material:binding = <../white>
        double3 xformOp:translate = (-1.9, -0.5, -5.45)
        float xformOp:rotateY = 0
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:scale"]
    }

    def DomeLight "dome"
    {
        float inputs:intensity = 1
    }
}
