        point3f[] points = [(-0.2887, 0.2887, -0.2887), (-0.3333, 0.1667, -0.3333), (-0.4082, 0.2041, -0.2041), (-0.3333, 0.3333, -0.1667), (-0.4472, 0.2236, 0.0), (-0.3536, 0.3536, 0.0), (-0.4082, 0.2041, 0.2041), (-0.3333, 0.3333, 0.1667), (-0.3333, 0.1667, 0.3333), (-0.2887, 0.2887, 0.2887), (-0.3536, -0.0, -0.3536), (-0.4472, -0.0, -0.2236), (-0.5, -0.0, 0.0), (-0.4472, -0.0, 0.2236), (-0.3536, -0.0, 0.3536), (-0.3333, -0.1667, -0.3333), (-0.4082, -0.2041, -0.2041), (-0.4472, -0.2236, 0.0), (-0.4082, -0.2041, 0.2041), (-0.3333, -0.1667, 0.3333), (-0.2887, -0.2887, -0.2887), (-0.3333, -0.3333, -0.1667), (-0.3536, -0.3536, 0.0), (-0.3333, -0.3333, 0.1667), (-0.2887, -0.2887, 0.2887), (0.2887, -0.2887, -0.2887), (0.3333, -0.1667, -0.3333), (0.4082, -0.2041, -0.2041), (0.3333, -0.3333, -0.1667), (0.4472, -0.2236, 0.0), (0.3536, -0.3536, 0.0), (0.4082, -0.2041, 0.2041), (0.3333, -0.3333, 0.1667), (0.3333, -0.1667, 0.3333), (0.2887, -0.2887, 0.2887), (0.3536, 0.0, -0.3536), (0.4472, 0.0, -0.2236), (0.5, 0.0, 0.0), (0.4472, 0.0, 0.2236), (0.3536, 0.0, 0.3536), (0.3333, 0.1667, -0.3333), (0.4082, 0.2041, -0.2041), (0.4472, 0.2236, 0.0), (0.4082, 0.2041, 0.2041), (0.3333, 0.1667, 0.3333), (0.2887, 0.2887, -0.2887), (0.3333, 0.3333, -0.1667), (0.3536, 0.3536, 0.0), (0.3333, 0.3333, 0.1667), (0.2887, 0.2887, 0.2887), (-0.2041, -0.4082, 0.2041), (-0.1667, -0.3333, 0.3333), (0.0, -0.4472, 0.2236), (0.0, -0.3536, 0.3536), (0.2041, -0.4082, 0.2041), (0.1667, -0.3333, 0.3333), (-0.2236, -0.4472, -0.0), (0.0, -0.5, -0.0), (0.2236, -0.4472, -0.0), (-0.2041, -0.4082, -0.2041), (0.0, -0.4472, -0.2236), (0.2041, -0.4082, -0.2041), (-0.1667, -0.3333, -0.3333), (0.0, -0.3536, -0.3536), (0.1667, -0.3333, -0.3333), (-0.2041, 0.4082, -0.2041), (-0.1667, 0.3333, -0.3333), (0.0, 0.4472, -0.2236), (0.0, 0.3536, -0.3536), (0.2041, 0.4082, -0.2041), (0.1667, 0.3333, -0.3333), (-0.2236, 0.4472, 0.0), (0.0, 0.5, 0.0), (0.2236, 0.4472, 0.0), (-0.2041, 0.4082, 0.2041), (0.0, 0.4472, 0.2236), (0.2