#usda 1.0
(
    doc = """Clay quads under light-linked lights: a sphere linked to the left quad alone, another linked to the group holding the right one, and a distant light linked to everything but the left quad. Frame 2 moves the spheres."""
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
}

def Mesh "left"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-3.3, -1, -5), (-1.3, -1, -5), (-1.3, 1, -5), (-3.3, 1, -5)]
}

def Mesh "middle"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-1, -1, -5), (1, -1, -5), (1, 1, -5), (-1, 1, -5)]
}

def Xform "group"
{
    def Mesh "right"
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(1.3, -1, -5), (3.3, -1, -5), (3.3, 1, -5), (1.3, 1, -5)]
    }
}

def SphereLight "key"
{
    uniform bool collection:lightLink:includeRoot = 0
    rel collection:lightLink:includes = </left>
    float inputs:radius = 0.2
    float inputs:intensity = 20
    double3 xformOp:translate.timeSamples = {
        1: (-2.3, 0.3, -3.5),
        2: (-1.8, -0.2, -3.2),
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def SphereLight "rim"
{
    uniform bool collection:lightLink:includeRoot = 0
    rel collection:lightLink:includes = </group>
    float inputs:radius = 0.2
    float inputs:intensity = 12
    double3 xformOp:translate.timeSamples = {
        1: (2.3, -0.3, -3.5),
        2: (1.8, 0.4, -3.2),
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

# 1.5 lux down -z, toward the quads.
def DistantLight "sun"
{
    rel collection:lightLink:excludes = </left>
    float inputs:angle = 0
    float inputs:intensity = 1.5
}
