def Material "glossy"
{
    token outputs:surface.connect = </glossy/surface.outputs:out>

    def Shader "surface"
    {
        uniform token info:id = "ND_open_pbr_surface_surfaceshader"
        color3f inputs:base_color = (1, 1, 1)
        float inputs:base_metalness = 1
        float inputs:specular_roughness = 0.3
        token outputs:out
    }
}

def Material "satin"
{
    token outputs:surface.connect = </satin/surface.outputs:out>

    def Shader "surface"
    {
        uniform token info:id = "ND_open_pbr_surface_surfaceshader"
        color3f inputs:base_color = (1, 1, 1)
        float inputs:base_metalness = 1
        float inputs:specular_roughness = 0.75
        token outputs:out
    }
}

def Mesh "glossy_ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
    inherits = </_ball>
)
{
    rel material:binding = </glossy>
    double3 xformOp:translate = (-0.45, 0, -6)
    float3 xformOp:scale = (2, 2, 2)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

def Mesh "satin_ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
    inherits = </_ball>
)
{
    rel material:binding = </satin>
    double3 xformOp:translate = (1.85, 0, -6)
    float3 xformOp:scale = (2, 2, 2)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

def DomeLight "dome"
{
    color3f inputs:color = (1, 0.8, 0.6)
    float inputs:intensity.timeSamples = {
        1: 0.5,
        2: 0.8,
    }
}
