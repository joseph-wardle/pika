#usda 1.0
(
    doc = """A clay quad facing the camera, one tilted back, and two white metal balls, of roughness 0.3 and 0.75, under a dome light with no image: a constant sky, of which a matte surface shows its albedo's share and a white metal all, whatever its roughness. Frame 2 brightens the dome."""
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
}

def Mesh "facing"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-2.9, 0.1, -6), (-1.7, 0.1, -6), (-1.7, 1.4, -6), (-2.9, 1.4, -6)]
}

def Mesh "tilted"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-0.6, -0.6, 0), (0.6, -0.6, 0), (0.6, 0.6, 0), (-0.6, 0.6, 0)]
    double3 xformOp:translate = (-2.3, -0.8, -6)
    float3 xformOp:rotateXYZ = (-50, 20, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

