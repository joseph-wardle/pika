#usda 1.0
(
    doc = """A clay ball and a white mirror ball under a dome light turned off the world's axes, its image a sky smooth in direction (bake/fixtures/sky.exr): the clay shows the sky summed over its hemisphere, the mirror the sky along the reflected ray. Frame 2 turns the dome."""
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
}

