def Material "mirror"
{
    token outputs:surface.connect = </mirror/surface.outputs:out>

    def Shader "surface"
    {
        uniform token info:id = "ND_open_pbr_surface_surfaceshader"
        color3f inputs:base_color = (1, 1, 1)
        float inputs:base_metalness = 1
        float inputs:specular_roughness = 0
        token outputs:out
    }
}

def Mesh "clay_ball" (
    inherits = </_ball>
)
{
    double3 xformOp:translate = (-1.4, 0, -6)
    float3 xformOp:scale = (2.4, 2.4, 2.4)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

def Mesh "mirror_ball" (
    prepend apiSchemas = ["MaterialBindingAPI"]
    inherits = </_ball>
)
{
    rel material:binding = </mirror>
    double3 xformOp:translate = (1.4, 0, -6)
    float3 xformOp:scale = (2.4, 2.4, 2.4)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

def DomeLight "dome"
{
    float inputs:intensity = 1
    asset inputs:texture:file = @../../bake/fixtures/sky.exr@
    token inputs:texture:format = "latlong"
    float3 xformOp:rotateXYZ.timeSamples = {
        1: (20, 40, 0),
        2: (-30, 110, 15),
    }
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}
