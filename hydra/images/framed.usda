#usda 1.0
(
    doc = "A 3:2 camera, moved and turned, rendered at 16:9. A quad wider than the aperture shows the expanded frustum."
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 50
    float horizontalAperture = 36
    float verticalAperture = 24
    float2 clippingRange = (0.1, 100)
    double3 xformOp:translate = (0.4, 0.2, 0)
    float3 xformOp:rotateXYZ = (5, -8, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

def Mesh "wide"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-2.4, -0.9, -6), (1.2, -0.9, -7), (1.2, 1.4, -7), (-2.4, 1.4, -6)]
    normal3f[] normals = [(0.1, 0, 1), (0.3, 0, 1), (0.3, 0.2, 1), (0.1, 0.2, 1)] (
        interpolation = "vertex"
    )
}
