#usda 1.0
(
    doc = """Clay quads, one facing the camera and one turned away, with no lights, rendered with the host's camera light off: they draw black."""
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
}

def Mesh "facing"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-2.4, -1, -5), (-0.4, -1, -5), (-0.4, 1, -5), (-2.4, 1, -5)]
}

def Mesh "turned"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(0, -1, 0), (2, -1, 0), (2, 1, 0), (0, 1, 0)]
    double3 xformOp:translate = (0.4, 0, -5)
    float3 xformOp:rotateXYZ = (0, -40, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}
