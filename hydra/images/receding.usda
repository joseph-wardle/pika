#usda 1.0
(
    doc = """Disks receding over a long clay ground, each twice as far and as wide as the last, so their shadows fall on clipmap levels from finest to coarse, and a roof above the frame casting into it. The pool, pika:shadowPool = 4 MB (16 pages), holds fewer pages than the camera marks, so the farthest levels drop a LOD; their texels stay under a pixel. usdrecord passes no render settings, so it draws them at the default pool. Frame 2 moves the camera and turns the key."""
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 200)
    double3 xformOp:translate.timeSamples = {
        1: (0, 1.5, 0),
        2: (0.3, 1.6, -2.5),
    }
    float3 xformOp:rotateXYZ = (-8, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

def Mesh "ground"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-40, 0, 2), (40, 0, 2), (40, 0, -120), (-40, 0, -120)]
}

