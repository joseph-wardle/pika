#usda 1.0
(
    doc = """Four clay floor tiles, each lit by one local light, which casts a caster's shadow on it: a sphere light whose caster's shadow straddles the edge between the cube's bottom face and a side face, a rect light facing down with a quad just behind it, on the side its five faces leave out, a tilted disk light behind a standing quad, whose shadow runs across side faces, and a cylinder light over a long strip. Frame 2 moves the sphere light and the camera and turns the disk light."""
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
    double3 xformOp:translate.timeSamples = {
        1: (0, 4.2, -0.6),
        2: (0.3, 4.4, -0.9),
    }
    float3 xformOp:rotateXYZ = (-50, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

def Mesh "near_left"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-3.1, 0, -1.9), (-0.1, 0, -1.9), (-0.1, 0, -4.9), (-3.1, 0, -4.9)]
}

def Mesh "near_right"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(0.1, 0, -1.9), (3.1, 0, -1.9), (3.1, 0, -4.9), (0.1, 0, -4.9)]
}

def Mesh "far_left"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-3.1, 0, -5.1), (-0.1, 0, -5.1), (-0.1, 0, -8.1), (-3.1, 0, -8.1)]
}

def Mesh "far_right"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(0.1, 0, -5.1), (3.1, 0, -5.1), (3.1, 0, -8.1), (0.1, 0, -8.1)]
}

# Half the sphere light's height and half its height off its foot, so its shadow
# lies across x = -1.6 + 1, where the bottom face meets the +x one.
def Mesh "sphere_caster"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-1.3, 0.5, -3.1), (-0.9, 0.5, -3.1), (-0.9, 0.5, -3.7), (-1.3, 0.5, -3.7)]
}

def Mesh "rect_caster"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(1.05, 0.6, -3.05), (1.55, 0.6, -3.05), (1.55, 0.6, -3.35), (1.05, 0.6, -3.35)]
}

# Above the rect light, which lights nothing on this side.
def Mesh "behind"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(1.45, 1.4, -3.25), (1.75, 1.4, -3.25), (1.75, 1.4, -3.55), (1.45, 1.4, -3.55)]
}

def Mesh "standing"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-1.2, 0, -6.2), (-1.25, 0, -7), (-1.25, 0.7, -7), (-1.2, 0.7, -6.2)]
}

def Mesh "strip"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(1.52, 0.45, -5.7), (1.68, 0.45, -5.7), (1.68, 0.45, -7.5), (1.52, 0.45, -7.5)]
}

# π (0.1 / d)² × 120 lux at d metres.
def SphereLight "bulb"
{
    float inputs:radius = 0.1
    float inputs:intensity = 120
    uniform bool collection:lightLink:includeRoot = 0
    rel collection:lightLink:includes = [</near_left>, </sphere_caster>]
    double3 xformOp:translate.timeSamples = {
        1: (-1.6, 1, -3.4),
        2: (-1.4, 1.1, -3.2),
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def RectLight "panel"
{
    float inputs:width = 0.6
    float inputs:height = 0.4
    float inputs:intensity = 24
    uniform bool collection:lightLink:includeRoot = 0
    rel collection:lightLink:includes = [</near_right>, </rect_caster>, </behind>]
    double3 xformOp:translate = (1.6, 1.2, -3.4)
    float3 xformOp:rotateXYZ = (-90, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

# Faces down and toward -x, so the standing quad's shadow falls on its far side.
def DiskLight "spot"
{
    float inputs:radius = 0.25
    float inputs:intensity = 32
    uniform bool collection:lightLink:includeRoot = 0
    rel collection:lightLink:includes = [</far_left>, </standing>]
    double3 xformOp:translate = (-0.4, 1.3, -6.6)
    float3 xformOp:rotateXYZ.timeSamples = {
        1: (-90, -35, 0),
        2: (-90, -45, 0),
    }
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

def CylinderLight "tube"
{
    float inputs:length = 0.8
    float inputs:radius = 0.05
    float inputs:intensity = 48
    uniform bool collection:lightLink:includeRoot = 0
    rel collection:lightLink:includes = [</far_right>, </strip>]
    double3 xformOp:translate = (1.6, 1, -6.6)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
