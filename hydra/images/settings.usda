#usda 1.0
(
    doc = "The render settings every scene in hydra/images/ sublayers: color, depth and normal AOVs of the camera at /camera."
)

def Scope "render"
{
    def RenderSettings "settings"
    {
        rel camera = </camera>
        uniform int2 resolution = (160, 90)
        uniform token aspectRatioConformPolicy = "expandAperture"
        rel products = </render/settings/product>

        def RenderProduct "product"
        {
            rel orderedVars = [
                </render/settings/product/color>,
                </render/settings/product/depth>,
                </render/settings/product/normal>,
            ]

            # husk names the Hydra AOV after driver:parameters:aov:husk:name,
            # not sourceName.
            def RenderVar "color"
            {
                uniform token dataType = "color4f"
                uniform string sourceName = "color"
                uniform token sourceType = "raw"
                string driver:parameters:aov:husk:name = "color"
            }

            def RenderVar "depth"
            {
                uniform token dataType = "float"
                uniform string sourceName = "depth"
                uniform token sourceType = "raw"
                string driver:parameters:aov:husk:name = "depth"
            }

            def RenderVar "normal"
            {
                uniform token dataType = "normal3f"
                uniform string sourceName = "normal"
                uniform token sourceType = "raw"
                string driver:parameters:aov:husk:name = "normal"
            }
        }
    }
}
