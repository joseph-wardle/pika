#usda 1.0
(
    doc = """A clay wall under a rect light a little over its width away, a tilted disk light and a rect light facing away from it: normalized at frame 1 and unnormalized at frame 2, where the controls are checked, the rect and disk scaled. Turned 90°, each stays above the wall's horizon."""
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
}

def Mesh "wall"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-4.3, -2.5, -8), (4.3, -2.5, -8), (4.3, 2.5, -8), (-4.3, 2.5, -8)]
}

# Radiance 3 at frame 1, of its area 0.96, and 2 at frame 2, 1.8 wide.
def RectLight "panel"
{
    float inputs:width = 1.2
    float inputs:height = 0.8
    float inputs:intensity.timeSamples = {
        1: 2.88,
        2: 2,
    }
    bool inputs:normalize.timeSamples = {
        1: 1,
        2: 0,
    }
    double3 xformOp:translate = (-2.2, 0.9, -7)
    float3 xformOp:scale.timeSamples = {
        1: (1, 1, 1),
        2: (1.5, 1, 1),
    }
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
}

# Radiance 2.5 at frame 1, of its area π / 4, and 1.5 at frame 2, of radius
# 0.7.
def DiskLight "spot"
{
    float inputs:radius = 0.5
    float inputs:intensity.timeSamples = {
        1: 1.9635,
        2: 1.5,
    }
    bool inputs:normalize.timeSamples = {
        1: 1,
        2: 0,
    }
    double3 xformOp:translate = (2.2, 0.8, -7)
    float3 xformOp:rotateXYZ = (0, 25, 0)
    float3 xformOp:scale.timeSamples = {
        1: (1, 1, 1),
        2: (1.4, 1.4, 1.4),
    }
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
}

# Shines toward the camera, so the wall behind it gets nothing.
def RectLight "backward"
{
    float inputs:width = 0.8
    float inputs:height = 0.6
    float inputs:intensity = 4
    double3 xformOp:translate = (0.3, -1.3, -7.5)
    float3 xformOp:rotateXYZ = (0, 180, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}
