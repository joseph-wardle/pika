#usda 1.0
(
    doc = "Meshes whose normals are computed: a Catmull-Clark bump with misleading authored normals and a hole, whose points move at frame 2; a left-handed Catmull-Clark cap of three triangles, a quad and a pentagon around a valence-5 point; a left-handed polygonal cone without normals; and a render-purpose and a proxy-purpose tile, which husk and usdrecord each draw one of."
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 50
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
}

def Mesh "bump"
{
    int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4]
    int[] faceVertexIndices = [0, 1, 6, 5, 1, 2, 7, 6, 2, 3, 8, 7, 3, 4, 9, 8, 5, 6, 11, 10, 6, 7, 12, 11, 7, 8, 13, 12, 8, 9, 14, 13]
    int[] holeIndices = [5]
    point3f[] points.timeSamples = {
        1: [(-1.6, -0.2, -5), (-1.3, -0.2, -4.85), (-0.85, -0.2, -4.7), (-0.6, -0.2, -4.9), (-0.2, -0.2, -5), (-1.6, 0.25, -4.9), (-1.3, 0.25, -4.55), (-0.85, 0.25, -4.4), (-0.6, 0.25, -4.65), (-0.2, 0.25, -4.95), (-1.6, 0.8, -5), (-1.3, 0.8, -4.8), (-0.85, 0.8, -4.75), (-0.6, 0.8, -4.9), (-0.2, 0.8, -5)],
        2: [(-1.6, -0.2, -5), (-1.3, -0.2, -4.9), (-0.85, -0.2, -4.85), (-0.6, -0.2, -4.8), (-0.2, -0.2, -4.95), (-1.6, 0.25, -4.95), (-1.3, 0.25, -4.8), (-0.85, 0.25, -4.5), (-0.6, 0.25, -4.4), (-0.2, 0.25, -4.9), (-1.6, 0.8, -5), (-1.3, 0.8, -4.95), (-0.85, 0.8, -4.7), (-0.6, 0.8, -4.75), (-0.2, 0.8, -5)],
    }
    normal3f[] normals = [(0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1), (0.3, -0.2, 1)] (
        interpolation = "vertex"
    )
}

def Mesh "cap"
{
    uniform token orientation = "leftHanded"
    int[] faceVertexCounts = [3, 3, 3, 4, 5]
    int[] faceVertexIndices = [0, 1, 2, 0, 2, 3, 0, 3, 4, 0, 4, 5, 6, 0, 6, 7, 8, 1]
    point3f[] points = [(1.15, -0.52, -4.6), (1.55, -0.52, -5), (1.433, -0.308, -4.9), (1.15, -0.22, -5), (0.867, -0.308, -4.9), (0.75, -0.52, -5), (0.867, -0.732, -4.9), (1.15, -0.82, -5), (1.433, -0.732, -4.9)]
}

def Mesh "cone"
{
    uniform token subdivisionScheme = "none"
    uniform token orientation = "leftHanded"
    int[] faceVertexCounts = [3, 3, 3, 3, 3, 3]
    int[] faceVertexIndices = [0, 2, 1, 0, 3, 2, 0, 4, 3, 0, 5, 4, 0, 6, 5, 0, 1, 6]
    point3f[] points = [(0.95, 0.3, -4.6), (1.4, 0.25, -5), (1.125, 0.518, -5), (0.712, 0.767, -5), (0.506, 0.319, -5), (0.49, -0.037, -5), (1.003, -0.032, -5)]
}

def Mesh "final"
{
    uniform token subdivisionScheme = "none"
    uniform token purpose = "render"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-0.9, -0.85, -5), (-0.4, -0.85, -4.8), (-0.4, -0.45, -4.8), (-0.9, -0.45, -5)]
}

def Mesh "draft"
{
    uniform token subdivisionScheme = "none"
    uniform token purpose = "proxy"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(0.1, -0.85, -4.8), (0.6, -0.85, -5), (0.6, -0.45, -5), (0.1, -0.45, -4.8)]
