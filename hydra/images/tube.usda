#usda 1.0
(
    doc = """A clay wall under a cylinder light half a metre away, at a slant, its ends within the frame: normalized at frame 1 and unnormalized at frame 2, where the controls are checked, lengthened by its scale."""
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
}

def Mesh "wall"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-4.3, -2.5, -8), (4.3, -2.5, -8), (4.3, 2.5, -8), (-4.3, 2.5, -8)]
}

# Radiance 6 at frame 1, of its side's area 2.26, and 6 at frame 2, 3.9
# long.
def CylinderLight "tube"
{
    float inputs:length = 3
    float inputs:radius = 0.12
    float inputs:intensity.timeSamples = {
        1: 13.572,
        2: 6,
    }
    bool inputs:normalize.timeSamples = {
        1: 1,
        2: 0,
    }
    double3 xformOp:translate = (-0.4, 0.3, -7.5)
    float3 xformOp:rotateXYZ = (0, 0, 15)
    float3 xformOp:scale.timeSamples = {
        1: (1, 1, 1),
        2: (1.3, 1, 1),
    }
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
}
