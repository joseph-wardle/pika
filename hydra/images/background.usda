#usda 1.0
(
    doc = """A glowing quad that no light reaches, through a wide lens, before a dome light whose image (bake/fixtures/ripples.exr) ripples round the sky and has a sun near the view's corner: the sky drawn behind shows the levels each pixel blends, by how flat the ripple is, finer toward the edges, where a pixel spans less of the sky, and the lens looks across the image's seam. Frame 2 turns the dome."""
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 12
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
}

def Mesh "quad" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-1, -1, -5), (1, -1, -5), (1, 1, -5), (-1, 1, -5)]
    rel material:binding = </glow>
}

def Material "glow"
{
    token outputs:surface.connect = </glow/surface.outputs:out>

    def Shader "surface"
    {
        uniform token info:id = "ND_standard_surface_surfaceshader"
        float inputs:base = 0
        float inputs:specular = 0
        float inputs:emission = 1
        color3f inputs:emission_color = (0.9, 0.9, 0.1)
        token outputs:out
    }
}

def DomeLight "dome"
{
    float inputs:intensity = 1
    asset inputs:texture:file = @../../bake/fixtures/ripples.exr@
    token inputs:texture:format = "latlong"
    float3 xformOp:rotateXYZ.timeSamples = {
        1: (0, 0, 0),
        2: (0, 15, 0),
    }
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}
