#usda 1.0
(
    doc = """Casters moving under lights and a camera that stay, so later frames keep the pages frame 1 drew and redraw only those a caster moved over: a clay floor tile under a distant light, with a quad that stays and one that slides past it at frame 2 and stops there, and one under a sphere light, with a quad that stays and one whose points bend at frames 2 and 3. The moving casters' old shadows are gone, the quads that stay keep theirs, also where a moving one's page is redrawn, and the slider keeps its shadow once it stops."""
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 3
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
    double3 xformOp:translate = (0, 4.2, -0.8)
    float3 xformOp:rotateXYZ = (-55, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

def Mesh "left"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-3.1, 0, -1.9), (-0.1, 0, -1.9), (-0.1, 0, -5.9), (-3.1, 0, -5.9)]
}

def Mesh "right"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(0.1, 0, -1.9), (3.1, 0, -1.9), (3.1, 0, -5.9), (0.1, 0, -5.9)]
}

def Mesh "post"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-1.9, 0.4, -3.4), (-1.5, 0.4, -3.4), (-1.5, 0.4, -3.8), (-1.9, 0.4, -3.8)]
}

def Mesh "slider"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-0.25, 0.4, 0.2), (0.25, 0.4, 0.2), (0.25, 0.4, -0.2), (-0.25, 0.4, -0.2)]
    double3 xformOp:translate.timeSamples = {
        1: (-2.5, 0, -3.6),
        2: (-1.0, 0, -4.6),
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Mesh "stone"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(1.9, 0.5, -3.3), (2.3, 0.5, -3.3), (2.3, 0.5, -3.7), (1.9, 0.5, -3.7)]
}

def Mesh "bent"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4, 4]
    int[] faceVertexIndices = [0, 1, 4, 3, 1, 2, 5, 4]
    point3f[] points.timeSamples = {
        1: [(0.8, 0.5, -3.2), (1.1, 0.5, -3.2), (1.4, 0.5, -3.2), (0.8, 0.5, -3.6), (1.1, 0.5, -3.6), (1.4, 0.5, -3.6)],
        2: [(0.8, 0.5, -3.2), (1.1, 0.5, -3.2), (1.3, 0.3, -4.4), (0.8, 0.5, -3.6), (1.1, 0.5, -3.6), (1.3, 0.3, -4.8)],
        3: [(0.8, 0.5, -3.2), (1.1, 0.5, -3.2), (1.25, 0.6, -2.6), (0.8, 0.5, -3.6), (1.1, 0.5, -3.6), (1.25, 0.6, -3.0)],
    }
}

# π lux on a surface facing it.
def DistantLight "key"
{
    float inputs:angle = 0
    float inputs:intensity = 3.1415927
    uniform bool collection:lightLink:includeRoot = 0
    rel collection:lightLink:includes = [</left>, </post>, </slider>]
    float3 xformOp:rotateXYZ = (-60, 20, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

# π (0.1 / d)² × 120 lux at d metres.
def SphereLight "bulb"
{
    float inputs:radius = 0.1
    float inputs:intensity = 120
    uniform bool collection:lightLink:includeRoot = 0
    rel collection:lightLink:includes = [</right>, </stone>, </bent>]
    double3 xformOp:translate = (1.6, 1.2, -3.5)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
