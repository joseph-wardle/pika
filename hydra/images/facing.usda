#usda 1.0
(
    doc = "An off-centre quad facing the camera, with vertex normals bent outward. Its points move at frame 2."
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 50
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
}

def Mesh "quad"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points.timeSamples = {
        1: [(-1.2, -0.3, -5), (0.2, -0.3, -5), (0.2, 0.7, -5), (-1.2, 0.7, -5)],
        2: [(-0.9, -0.5, -5), (0.5, -0.5, -5), (0.5, 0.5, -5), (-0.9, 0.5, -5)],
    }
    normal3f[] normals = [(-0.3, -0.3, 1), (0.3, -0.3, 1), (0.3, 0.3, 1), (-0.3, 0.3, 1)] (
        interpolation = "vertex"
    )
}
