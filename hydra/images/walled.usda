#usda 1.0
(
    doc = """Two native instances of a clay post on a clay ground, beside a plain louvre. The sun's shadowLink leaves out the louvre alone, so the posts cast and the louvre does not; the fill, its shadows off, lights everything but the second post. Each instance is linked by its own path, not its prototype's. Frame 2 turns the sun."""
    subLayers = [@settings.usda@]
    startTimeCode = 1
    endTimeCode = 2
    metersPerUnit = 1
    upAxis = "Y"
)

def Camera "camera"
{
    float focalLength = 35
    float horizontalAperture = 36
    float verticalAperture = 20.25
    float2 clippingRange = (0.1, 100)
    double3 xformOp:translate = (0, 2, 0)
    float3 xformOp:rotateXYZ = (-25, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
}

def Mesh "ground"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-5, -1, -1), (5, -1, -1), (5, -1, -12), (-5, -1, -12)]
}

class Xform "_post"
{
    def Mesh "panel"
    {
        uniform token subdivisionScheme = "none"
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-0.4, -1, 0), (0.4, -1, 0), (0.4, 0.4, 0), (-0.4, 0.4, 0)]
    }
}

def Xform "posts"
{
    def Xform "a" (
        instanceable = true
        references = </_post>
    )
    {
        double3 xformOp:translate = (-1.6, 0, -6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "b" (
        instanceable = true
        references = </_post>
    )
    {
        double3 xformOp:translate = (0, 0, -6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Mesh "louvre"
{
    uniform token subdivisionScheme = "none"
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(1.2, -1, -6), (2, -1, -6), (2, 0.4, -6), (1.2, 0.4, -6)]
}

# π lux on a surface facing it.
def DistantLight "sun" (
    prepend apiSchemas = ["ShadowAPI"]
)
{
    float inputs:angle = 0
    float inputs:intensity = 3.1415927
    rel collection:shadowLink:excludes = </louvre>
    float3 xformOp:rotateXYZ.timeSamples = {
        1: (-40, 20, 0),
        2: (-35, -25, 0),
    }
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def DistantLight "fill" (
    prepend apiSchemas = ["ShadowAPI"]
)
{
    float inputs:angle = 0
    float inputs:intensity = 0.5
    bool inputs:shadow:enable = 0
    rel collection:lightLink:excludes = </posts/b>
    float3 xformOp:rotateXYZ = (-20, -30, 0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}
